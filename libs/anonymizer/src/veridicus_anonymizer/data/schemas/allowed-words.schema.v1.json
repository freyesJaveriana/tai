{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "veridicus/anonymizer/allowed-words.schema.v1",
  "title": "Palabras con mayúscula que la red de seguridad no seudonimiza (AllowedWordList, BR1.5)",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "words"],
  "properties": {
    "schema_version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "words": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1, "maxLength": 64}
    }
  }
}
