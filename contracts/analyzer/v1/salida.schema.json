{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "veridicus/contracts/analyzer/v1/salida",
  "title": "Salida del contrato común del analizador",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contrato",
    "analizador",
    "version",
    "entrevista",
    "prompt_sha256",
    "perfil",
    "config_sha256",
    "fecha",
    "estado",
    "hallazgos",
    "registro"
  ],
  "properties": {
    "contrato": {
      "const": "1.0.0"
    },
    "analizador": {
      "const": "incoherencias"
    },
    "version": {
      "type": "string",
      "description": "Versión del analizador (paquete de U11)"
    },
    "entrevista": {
      "type": "string"
    },
    "prompt_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "perfil": {
      "type": "string"
    },
    "config_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "fecha": {
      "type": "string",
      "format": "date-time"
    },
    "estado": {
      "enum": [
        "ok",
        "error"
      ]
    },
    "error": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "codigo"
      ],
      "properties": {
        "codigo": {
          "enum": [
            "salida_invalida",
            "bloqueo_contenido",
            "tiempo_agotado",
            "proveedor",
            "anonimizador_no_disponible",
            "incidente_anonimizacion"
          ]
        }
      }
    },
    "hallazgos": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/hallazgo"
      }
    },
    "observaciones_conductor": {
      "type": "array",
      "description": "Solo en modo incremental (DT23); vocabulario cerrado",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "tipo",
          "tema",
          "turnos"
        ],
        "properties": {
          "tipo": {
            "const": "aclaracion_neutra"
          },
          "tema": {
            "type": "string",
            "minLength": 1,
            "description": "Nunca el texto de las citas ni «antes dijo» (VE-05)"
          },
          "turnos": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "pattern": "^T[0-9]+$"
            }
          }
        }
      }
    },
    "registro": {
      "$ref": "#/$defs/registro"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "estado": {
            "const": "error"
          }
        }
      },
      "then": {
        "required": [
          "error"
        ],
        "properties": {
          "hallazgos": {
            "maxItems": 0
          },
          "observaciones_conductor": {
            "maxItems": 0
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "estado": {
            "const": "ok"
          }
        }
      },
      "then": {
        "not": {
          "required": [
            "error"
          ]
        }
      }
    }
  ],
  "$defs": {
    "cita": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "cita",
        "turno"
      ],
      "properties": {
        "cita": {
          "type": "string",
          "minLength": 1,
          "description": "Texto literal; « […] » separa fragmentos del mismo turno en orden"
        },
        "turno": {
          "type": "string",
          "pattern": "^T[0-9]+$"
        },
        "pagina": {
          "type": "integer",
          "minimum": 1,
          "description": "Ausente si el turno no tiene página"
        },
        "avisos": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "enum": [
              "turno_entrevistador",
              "turno_plegado"
            ]
          }
        }
      }
    },
    "hallazgo": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "hecho",
        "tipo",
        "cita_a",
        "cita_b",
        "observaciones"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^.+-C[0-9]{2,}$",
          "description": "<entrevista>-C<nn>"
        },
        "hecho": {
          "type": "string",
          "minLength": 1
        },
        "tipo": {
          "enum": [
            "fecha",
            "numero",
            "lugar",
            "persona",
            "negacion",
            "secuencia",
            "otro"
          ]
        },
        "actos": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "cita_a": {
          "$ref": "#/$defs/cita"
        },
        "cita_b": {
          "$ref": "#/$defs/cita"
        },
        "observaciones": {
          "type": "string",
          "minLength": 1,
          "description": "Justificación sin juicio sobre la persona"
        }
      }
    },
    "registro": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "llamadas",
        "descartes",
        "fragmentado",
        "tokens_entrada",
        "tokens_salida"
      ],
      "properties": {
        "llamadas": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "papel",
              "proveedor",
              "modelo",
              "tokens_entrada",
              "tokens_salida",
              "proveedor_alterno",
              "anonimizado",
              "fecha"
            ],
            "properties": {
              "papel": {
                "enum": [
                  "juez",
                  "verificador",
                  "verificador_permutado"
                ]
              },
              "proveedor": {
                "type": "string"
              },
              "modelo": {
                "type": "string"
              },
              "version": {
                "type": "string"
              },
              "esfuerzo_o_cuantizacion": {
                "type": "string"
              },
              "motor": {
                "type": "string"
              },
              "semilla": {
                "type": "integer"
              },
              "tokens_entrada": {
                "type": "integer",
                "minimum": 0
              },
              "tokens_salida": {
                "type": "integer",
                "minimum": 0
              },
              "proveedor_alterno": {
                "type": "boolean"
              },
              "anonimizado": {
                "type": "boolean",
                "description": "false con un proveedor local; false con un destino externo es un incidente"
              },
              "fecha": {
                "type": "string",
                "format": "date-time"
              }
            }
          }
        },
        "descartes": {
          "type": "array",
          "description": "Candidatos que no salieron; sin texto de citas",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "motivo"
            ],
            "properties": {
              "motivo": {
                "enum": [
                  "cita_no_verificada",
                  "cita_en_otro_turno",
                  "marca_alterada",
                  "campo_faltante",
                  "rechazado_verificador",
                  "rechazado_permutacion",
                  "fuera_de_tramo",
                  "vocabulario_prohibido"
                ]
              },
              "turno_a": {
                "type": "string",
                "pattern": "^T[0-9]+$"
              },
              "turno_b": {
                "type": "string",
                "pattern": "^T[0-9]+$"
              }
            }
          }
        },
        "fragmentado": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "activo"
          ],
          "properties": {
            "activo": {
              "type": "boolean"
            },
            "ventana": {
              "type": "integer",
              "minimum": 1,
              "description": "En turnos (C25)"
            },
            "solapamiento": {
              "type": "integer",
              "minimum": 0
            }
          }
        },
        "tokens_entrada": {
          "type": "integer",
          "minimum": 0
        },
        "tokens_salida": {
          "type": "integer",
          "minimum": 0
        },
        "costo_estimado": {
          "type": "number",
          "minimum": 0,
          "description": "Según la tabla de precios de C18 (FR15.4); sin tope en el MVP"
        },
        "tabla_precios": {
          "type": "string",
          "description": "Versión de la tabla usada"
        }
      }
    }
  }
}
