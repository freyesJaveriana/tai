{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "veridicus/anonymizer/detection-rules.schema.v1",
  "title": "Reglas de detección en español (DetectionRuleSet, BR1.2)",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "person_patterns", "place_patterns", "case_number_patterns", "identifier_patterns"],
  "properties": {
    "schema_version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "person_patterns": {"$ref": "#/$defs/patterns"},
    "place_patterns": {"$ref": "#/$defs/patterns"},
    "case_number_patterns": {"$ref": "#/$defs/patterns"},
    "identifier_patterns": {"$ref": "#/$defs/patterns"}
  },
  "$defs": {
    "patterns": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "pattern", "examples_positive", "examples_negative"],
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z][a-z0-9_]{0,63}$"},
          "pattern": {"type": "string", "minLength": 1, "maxLength": 512},
          "examples_positive": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
          "examples_negative": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}
        }
      }
    }
  }
}
