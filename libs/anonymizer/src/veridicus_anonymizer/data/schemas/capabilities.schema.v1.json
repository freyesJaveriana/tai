{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "veridicus/anonymizer/capabilities.schema.v1",
  "title": "Capacidades por proveedor y modelo (ProviderCapabilityTable, BR5.2)",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "entries"],
  "properties": {
    "schema_version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "entries": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["provider", "model", "structured_mode", "effort_parameter"],
        "properties": {
          "provider": {"enum": ["anthropic", "google", "openai"]},
          "model": {"type": "string", "pattern": "^[A-Za-z0-9._:/@+-]{1,128}$"},
          "structured_mode": {"enum": ["json_schema_native", "forced_tool"]},
          "effort_parameter": {"type": "string", "pattern": "^[A-Za-z0-9._-]{1,64}$"}
        }
      }
    }
  }
}
