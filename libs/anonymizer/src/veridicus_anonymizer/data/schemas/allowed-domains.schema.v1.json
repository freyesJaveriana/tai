{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "veridicus/anonymizer/allowed-domains.schema.v1",
  "title": "Dominios de los proveedores permitidos (ProviderDomainList, C22, BR3.1)",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "entries"],
  "properties": {
    "schema_version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "entries": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["provider", "domain"],
        "properties": {
          "provider": {"enum": ["anthropic", "google", "openai"]},
          "domain": {"type": "string", "pattern": "^[a-z0-9]([a-z0-9-]*[a-z0-9])?(\\.[a-z0-9]([a-z0-9-]*[a-z0-9])?)+$"}
        }
      }
    }
  }
}
